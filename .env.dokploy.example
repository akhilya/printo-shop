# Вставить в Environment у Compose-приложения в Dokploy.
# Секреты не коммитить.

# Без www. www.<STORE_HOST> редиректит сюда. CNAME www — это не редирект.
STORE_HOST=shop.example.com
API_HOST=api.example.com

POSTGRES_PASSWORD=change-me
# POSTGRES_USER / POSTGRES_DB / DATABASE_URL не задавайте.
# В Docker пользователь и база всегда medusa, хост printo-pg.

JWT_SECRET=change-me-long-random
COOKIE_SECRET=change-me-long-random

MEDUSA_BACKEND_URL=https://api.example.com
# Адрес с www — другой Origin. Пока редирект не включился, API должен пускать оба.
STORE_CORS=https://shop.example.com,https://www.shop.example.com
ADMIN_CORS=https://api.example.com
AUTH_CORS=https://shop.example.com,https://www.shop.example.com,https://api.example.com

# Образы собирает GitHub Actions и кладёт в GHCR.
# В Dokploy: Registry → ghcr.io, username GitHub, password = PAT с read:packages.
BACKEND_IMAGE=ghcr.io/akhilya/printo-shop/backend:latest
STOREFRONT_IMAGE=ghcr.io/akhilya/printo-shop/storefront:latest

# URL API запекается в образ витрины на CI (переменная репо VITE_MEDUSA_BACKEND_URL).
# Здесь больше не нужен для сборки, только как напоминание адреса.
VITE_MEDUSA_BACKEND_URL=https://api.example.com

# Т-Банк настраивается в админке (Настройки), не здесь.

# Yandex Cloud Postbox. 587 всегда STARTTLS, 465 — SMTPS.
SMTP_HOST=postbox.cloud.yandex.net
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PrintO.studio <mail@example.com>
