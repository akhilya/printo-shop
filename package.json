{
  "name": "shop",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "shop": "npm run infra:up && npm run dev",
    "dev": "turbo dev --filter=@dtc/backend --filter=@dtc/storefront",
    "build": "turbo build --filter=@dtc/backend",
    "start": "turbo start --filter=@dtc/backend",
    "lint": "turbo lint --filter=@dtc/backend",
    "test": "turbo test --filter=@dtc/backend",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "backend:migrate": "npm exec --workspace=@dtc/backend -- medusa db:migrate"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.20.1",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14",
    "ajv": "^8.13.0"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  }
}