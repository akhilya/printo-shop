# Т-Банк, Ozon и режим витрины: админка → Настройки
# OZON_CLIENT_ID — Client ID частного приложения
# OZON_OAUTH_TOKEN — Client Secret частного приложения
# Кабинет подключается кнопкой в админке (OAuth продавца), не client_credentials

# Yandex Cloud Postbox (письма о заказе). Пустой SMTP_HOST — письма не уходят.
# 587 всегда STARTTLS, 465 — SMTPS. SMTP_STARTTLS больше не выключает шифрование.
SMTP_HOST=postbox.cloud.yandex.net
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PrintO.studio <mail@example.com>
